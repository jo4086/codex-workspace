#!/usr/bin/env node

const fs = require('node:fs');

const allowedTypes = new Set([
  'feat', 'fix', 'refactor', 'perf', 'docs', 'style',
  'test', 'build', 'ci', 'chore', 'revert',
]);

function validateSubject(subject) {
  const errors = [];
  const warnings = [];
  const match = /^([a-z]+)(?:\(([^)]*)\))?(!)?: (.*)$/.exec(subject);

  if (!match) {
    errors.push('제목 형식은 <type>(<scope>)!: <설명>이며 scope와 !는 선택입니다. 정확한 ": " 구분자가 필요합니다.');
  } else {
    const [, type, scope, , description] = match;
    if (!allowedTypes.has(type)) errors.push(`허용되지 않은 Type입니다: ${type}`);
    if (scope !== undefined && !/^[a-z0-9-]+$/.test(scope)) errors.push('Scope에는 영문 소문자, 숫자, 하이픈만 사용할 수 있습니다.');
    if (description.trim().length === 0) errors.push('설명이 비어 있습니다.');
    if (subject.trimEnd().endsWith('.')) errors.push('제목 끝에 마침표를 사용할 수 없습니다.');
    if ([...subject].length > 72) warnings.push('제목이 72자를 초과했습니다.');
  }

  return { errors, warnings };
}

function main(messagePath) {
  if (!messagePath) {
    process.stderr.write('commit-msg: Git이 전달한 커밋 메시지 파일 경로가 없습니다.\n');
    return 1;
  }

  let content;
  try {
    content = fs.readFileSync(messagePath, 'utf8');
  } catch (error) {
    process.stderr.write(`commit-msg: 커밋 메시지 파일을 읽을 수 없습니다: ${error.message}\n`);
    return 1;
  }

  const subject = content.split(/\r?\n/, 1)[0];
  const { errors, warnings } = validateSubject(subject);
  for (const error of errors) process.stderr.write(`commit-msg: ${error}\n`);
  for (const warning of warnings) process.stderr.write(`commit-msg: 경고: ${warning}\n`);
  return errors.length > 0 ? 1 : 0;
}

if (require.main === module) process.exitCode = main(process.argv[2]);

module.exports = { main, validateSubject };
